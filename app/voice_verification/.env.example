# Copy to .env.local. Do not commit .env.local.
VOICE_MATCHER_URL=http://127.0.0.1:8011
VOICE_MATCHER_TOKEN=change-this-local-token
VOICE_MATCHER_DATABASE=./data/voice_matcher.db

# Path to the documented fine-tuned RawNet3 best.pt artifact.
VOICE_MODEL_CHECKPOINT=../../rawnet3/runs/vimd/checkpoints/best.pt
VOICE_MODEL_CACHE_DIR=./data/model-cache
VOICE_MODEL_DEVICE=cpu
VOICE_SV_THRESHOLD=0.6565317440180312
VOICE_SHOW_DEBUG_SCORE=false
VOICE_HE_CONTEXT_MODE=session

# Agent only. The default Streamlit flow keeps an in-memory HE context.
# Set this once and re-enroll after intentionally creating a persistent context.
VOICE_HE_KEYCHAIN_SERVICE=who-speak.voice-he
VOICE_HE_KEYCHAIN_ACCOUNT=local-owner
# Legacy Streamlit/standalone Agent fallback only. The React gateway selects
# the enrolled target from signed LiveKit dispatch metadata instead.
VOICE_OWNER_ID=
VOICE_AUTH_TTL_SECONDS=300

# Local LiveKit development server. Do not use these development credentials remotely.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
# At least 32 characters avoids weak-HMAC warnings from the LiveKit SDK.
LIVEKIT_API_SECRET=local-livekit-secret-change-me-please-32
LIVEKIT_DEV_MODE=true
VOICE_AGENT_RUNTIME=livekit
# Pipecat mode uses a gateway-managed one-room worker. Keep livekit while the
# Pipecat path is being validated; never run both runtimes in the same room.
PIPECAT_SUPERVISOR_URL=http://127.0.0.1:8021
# Generate locally, for example: `python -c 'import secrets; print(secrets.token_urlsafe(32))'`.
# The gateway and supervisor must use the same value; never expose it to Vite.
PIPECAT_SUPERVISOR_SECRET=

# Phase 4 provider configuration. Keep this key only in the Python Agent process.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# Keep false while validating voice auth. When enabled, the Agent runs local
# streaming local turn detector + local Whisper, sends transcript only to OpenAI,
# then starts ZeroTTS streaming one bounded sentence at a time.
VOICE_AGENT_CONVERSATION_ENABLED=false
# Keep false during local model downloads. `true` uses lk's source watcher and
# can restart a job when a model cache inside the workspace changes.
VOICE_AGENT_HOT_RELOAD=false
VOICE_WHISPER_MODEL=base
VOICE_WHISPER_DEVICE=cpu
# Pipecat TTS. ZeroTTS is the Vietnamese streaming primary; Edge remains a
# fallback. ZeroTTS's public package uses preset voices, not enrollment audio.
VOICE_TTS_PROVIDER=zerotts
VOICE_TTS_FALLBACK_PROVIDER=edge
VOICE_ZEROTTS_MODEL=zeroweight-ai/ZeroTTS
VOICE_ZEROTTS_VOICE=maichi
VOICE_ZEROTTS_CACHE_DIR=./app/voice_verification/data/model-cache/zerotts
VOICE_ZEROTTS_WARMUP=true
VOICE_TTS_QUEUE_MAX_CHUNKS=8
VOICE_TTS_MAX_SENTENCE_CHARS=120
VOICE_EDGE_TTS_VOICE=vi-VN-HoaiMyNeural
VOICE_TTS_TIMEOUT_SECONDS=10
# Stop a Pipecat worker if the browser never joins its newly-created room.
VOICE_AGENT_JOIN_TIMEOUT_SECONDS=45
# Pipecat runtime: Silero VAD starts after 384ms and reports a raw stop after
# 200ms. Local Smart Turn decides whether that stop is a complete thought.
VOICE_VAD_MIN_SPEECH_SECONDS=0.384
VOICE_VAD_SILENCE_SECONDS=0.2
VOICE_VAD_MAXIMUM_SECONDS=10
VOICE_SMART_TURN_MODEL_PATH=
VOICE_SMART_TURN_CPU_COUNT=1
VOICE_SMART_TURN_PRE_SPEECH_MS=500
VOICE_SMART_TURN_MAX_WAIT_SECONDS=2

# Local React/Vite gateway + explicit Mock MCP phase.
WHO_SPEAK_GATEWAY_DATABASE=./app/voice_verification/data/who_speak_gateway.db
MCP_PROVIDER=mock
MOCK_CALENDAR_ENABLED=true
